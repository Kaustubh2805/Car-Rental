SECRET_KEY=replace-this-placeholder-with-at-least-50-random-characters-before-use
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=carrental
DB_USER=carrental_user
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-this-root-password

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Production (use HTTPS and real, strong secrets in production)
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
TRUST_X_FORWARDED_PROTO=True
SECURE_REFERRER_POLICY=same-origin

# Docker Compose local values (Compose overrides DB_HOST and allowed origins)
# ALLOWED_HOSTS=localhost,127.0.0.1,web
# CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
